// OpenSWOS Setup's look: StorageAgent's dark palette and buttons, cut down to
// what a one-page setup window uses.
import { LineEdit } from "std-widgets.slint";
export global Theme {
    out property <color> chrome:   #0d1014;
    out property <color> panel:    #1a1f27;
    out property <color> sunken:   #39414d;
    out property <color> line:     #2e3641;
    out property <color> hover:    #232a34;
    out property <color> field:    #14181e;
    out property <color> text:     #e4eaf2;
    out property <color> text-dim: #8592a2;
    out property <color> accent:   #3d7ddb;
    out property <color> ok:       #4cb87a;
    out property <color> danger:   #e5534b;
    out property <color> warn:     #e0a640;   // installed, but by an older setup
    out property <color> link:     #6ea8ff;
}

export component TextButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;       // optional, one colour, left of the label
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 28px;
    min-width: content.preferred-width + 24px;
    border-radius: 4px;
    border-width: 1px;
    border-color: root.primary && root.enabled ? Theme.accent : Theme.sunken;
    background: !root.enabled ? Theme.panel
        : root.primary ? (area.pressed ? Theme.accent.darker(0.25)
                          : area.has-hover ? Theme.accent.brighter(0.15) : Theme.accent)
        : area.pressed ? Theme.line
        : area.has-hover ? Theme.hover
        : Theme.panel;

    content := HorizontalLayout {
        alignment: center;
        spacing: 6px;
        if root.icon.width > 0: Image {
            source: root.icon;
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            colorize: !root.enabled ? Theme.sunken : root.primary ? #ffffff : Theme.text;
        }
        Text {
            text: root.label;
            font-size: 13px;
            font-weight: root.primary ? 700 : 400;
            color: !root.enabled ? Theme.sunken : root.primary ? #ffffff : Theme.text;
            vertical-alignment: center;
        }
    }
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// A link: underlined on hover, opens through the host.
export component Link inherits Text {
    in property <string> url;
    callback open(string);
    color: ta.has-hover ? Theme.link.brighter(0.2) : Theme.link;
    font-size: 13px;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(root.url); }
    }
    Rectangle {
        y: parent.height - 2px;
        height: 1px;
        background: ta.has-hover ? Theme.link : transparent;
    }
}

export component Card inherits Rectangle {
    in property <string> title;
    // Its own height, never a share of the window's spare: a Rectangle stretches by default.
    vertical-stretch: 0;
    background: Theme.panel;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.line;
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        if root.title != "": Text {
            text: root.title;
            font-size: 14px;
            font-weight: 700;
            color: Theme.text;
        }
        @children
    }
}

// A square button with a one-colour icon, tinted to the theme.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    in property <string> tooltip;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.sunken;
    background: !root.enabled ? Theme.panel
        : area.pressed ? Theme.line
        : area.has-hover ? Theme.hover
        : Theme.panel;
    accessible-role: button;
    accessible-label: root.tooltip;

    Image {
        source: root.icon;
        width: 16px;
        height: 16px;
        colorize: root.enabled ? Theme.text : Theme.sunken;
    }
    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// A path to type or paste. edited() on every change, committed() on Enter
// or when it loses focus; `invalid` draws it in the danger colour. `value` is
// what the program says the path is: a change to it is put in the box even
// after the player has typed there (which ends a plain binding).
export component PathField inherits Rectangle {
    in property <string> value;
    in property <string> placeholder;
    in property <bool> enabled: true;
    in property <bool> invalid;
    callback edited(string);
    callback committed(string);

    height: 28px;
    edit := LineEdit {
        width: 100%;
        height: 100%;
        init => { self.text = root.value; }
        placeholder-text: root.placeholder;
        enabled: root.enabled;
        font-size: 13px;
        edited(t) => { root.edited(t); }
        accepted(t) => { root.committed(t); }
        changed has-focus => {
            if (!self.has-focus) {
                root.committed(self.text);
            }
        }
    }
    changed value => {
        if (edit.text != root.value) {
            edit.text = root.value;
        }
    }
    // The danger border over the widget's own, when the path is not usable.
    if root.invalid: Rectangle {
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.danger;
    }
}
