// OpenSWOS Setup: one window, top to bottom -- what is needed, where it was
// found, where it goes, what will be made, and the button that makes it.
import { ListView, ProgressIndicator, Palette } from "std-widgets.slint";
import { Theme, TextButton, Link, Card, IconButton, PathField } from "theme.slint";

export { Theme }

// One source: its path as shown, and its state -- 0 none, 1 found, 2 not usable.
export struct SourceRow {
    label: string,
    value: string,
    state: int,
    placeholder: string,
}

// One step: `ready` when its sources are there (Install makes it), and what
// the assets folder has of it already -- 0 nothing, 1 all of it, 2 some.
export struct PlanStep {
    name: string,
    ready: bool,
    needs: string,
    installed: int,
}

component PlanColumn inherits VerticalLayout {
    in property <[PlanStep]> steps;
    horizontal-stretch: 1;
    spacing: 4px;
    alignment: start;
    for step in root.steps: VerticalLayout {
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: step.installed == 3 ? "!" : step.ready || step.installed == 1 ? "✓" : "–";
                width: 14px;
                color: step.installed == 3 ? Theme.warn
                     : step.ready || step.installed == 1 ? Theme.ok : Theme.text-dim;
            }
            Text {
                text: step.name;
                horizontal-stretch: 1;
                color: step.ready || step.installed == 1 || step.installed == 3 ? Theme.text : Theme.text-dim;
                overflow: elide;
            }
            Text {
                text: step.installed == 3 ? (step.ready ? "update needed" : "update needed: add its source")
                    : step.ready ? (step.installed == 1 ? "ready (installed)" : "ready")
                    : step.installed == 1 ? "installed"
                    : step.installed == 2 ? "incomplete"
                    : "skipped";
                color: step.installed == 3 ? Theme.warn
                     : step.ready || step.installed == 1 ? Theme.ok
                     : step.installed == 2 ? Theme.danger : Theme.text-dim;
            }
        }
        if !step.ready && step.installed != 1 && step.installed != 3: Text {
            x: 22px;
            text: "needs " + step.needs;
            font-size: 11px;
            color: Theme.text-dim;
            overflow: elide;
        }
    }
}

export component MainWindow inherits Window {
    title: "OpenSWOS Setup";
    icon: @image-url("../../../../packaging/linux/hicolor/256x256/apps/openswos.png");
    preferred-width: 820px;
    preferred-height: 900px;
    min-width: 700px;
    background: Theme.chrome;
    default-font-size: 13px;

    in property <[SourceRow]> sources;
    in property <string> notice;
    in property <bool> notice-error;
    in property <string> out-dir;
    in property <string> out-note;
    // The plan in two columns, so the window stays about 900 pixels tall.
    in property <[PlanStep]> plan-left;
    in property <[PlanStep]> plan-right;
    in property <bool> can-install;
    in property <bool> busy;
    in property <bool> done;
    // Some installed part was made by an older setup: Install becomes Update.
    in property <bool> outdated;
    in property <float> progress;
    in property <string> status;
    in property <bool> status-error;
    in property <[string]> log;
    in property <bool> can-play;
    in property <string> drawer;
    in property <string> drawer-status;
    in property <bool> drawer-error;
    in property <bool> can-pick: true;
    in property <bool> scanning;
    in property <string> scan-status;

    callback choose-folder();
    callback browse-source(int);
    callback source-edited(int, string);
    callback source-committed(int, string);
    callback stop-scan();
    callback clear-sources();
    callback change-out();
    callback install();
    callback play();
    callback open-url(string);
    callback browse-drawer();
    callback fill-drawer();

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    // Each log line is one fixed-height row, so "scrolled to the bottom" is
    // arithmetic rather than a measurement that lags a frame behind.
    property <length> log-row: 16px;
    property <int> log-count: root.log.length;
    changed log-count => {
        log-view.viewport-y = min(0px, log-view.visible-height - root.log-count * root.log-row);
    }

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        // 1. What this is.
        Card {
            HorizontalLayout {
                spacing: 12px;
                Image {
                    source: @image-url("../../../../packaging/linux/hicolor/64x64/apps/openswos.png");
                    width: 48px;
                    height: 48px;
                    vertical-alignment: top;
                }
                VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "OpenSWOS needs your own copy of Sensible World of Soccer";
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.text;
                    }
                    Text {
                        text: "OpenSWOS does not include the original game's data. Choose the folder your copy is in and it builds the files the game reads from it. Nothing is downloaded.";
                        wrap: word-wrap;
                        color: Theme.text-dim;
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        alignment: start;
                        Link { text: "PC version on GOG"; url: "https://www.gog.com/en/game/sensible_world_of_soccer_9697"; open(u) => { root.open-url(u); } }
                        Link { text: "PC CD version (archive.org)"; url: "https://archive.org/details/msdos_Sensible_World_of_Soccer_96-97_1996"; open(u) => { root.open-url(u); } }
                        Link { text: "Jaguar cartridge (Atarimania)"; url: "https://www.atarimania.com/games/atari-jaguar-games-sensible-soccer-international-edition-30123"; open(u) => { root.open-url(u); } }
                    }
                }
            }
        }

        // 2. Where the game is.
        Card {
            title: "Your copy of the game";
            Text {
                text: "Choose a folder and it, and every folder inside it, are searched for all of these. Or give each one yourself: paste its path, or press … to browse for it.";
                wrap: word-wrap;
                color: Theme.text-dim;
                font-size: 12px;
            }
            for row[i] in root.sources: HorizontalLayout {
                spacing: 8px;
                Text {
                    text: row.label;
                    width: 190px;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Image {
                        width: 16px;
                        height: 16px;
                        source: row.state == 1 ? @image-url("icons/circle-check.svg")
                              : row.state == 2 ? @image-url("icons/alert-circle.svg")
                              : @image-url("icons/circle-dashed.svg");
                        colorize: row.state == 1 ? Theme.ok : row.state == 2 ? Theme.danger : Theme.text-dim;
                    }
                }
                PathField {
                    horizontal-stretch: 1;
                    value: row.value;
                    placeholder: row.placeholder;
                    invalid: row.state == 2;
                    enabled: !root.busy;
                    edited(t) => { root.source-edited(i, t); }
                    committed(t) => { root.source-committed(i, t); }
                }
                IconButton {
                    icon: @image-url("icons/browse.svg");
                    tooltip: "Browse for " + row.label;
                    enabled: !root.busy && root.can-pick;
                    clicked => { root.browse-source(i); }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                if !root.scanning: TextButton {
                    label: "Choose a folder…";
                    icon: @image-url("icons/folder-search.svg");
                    primary: true;
                    enabled: !root.busy && root.can-pick;
                    clicked => { root.choose-folder(); }
                }
                if root.scanning: TextButton {
                    label: "Stop";
                    icon: @image-url("icons/player-stop.svg");
                    clicked => { root.stop-scan(); }
                }
                TextButton {
                    label: "Start over";
                    enabled: !root.busy;
                    clicked => { root.clear-sources(); }
                }
                Text {
                    text: root.scanning ? root.scan-status : root.notice;
                    overflow: elide;
                    horizontal-stretch: 1;
                    color: root.notice-error ? Theme.danger : Theme.text-dim;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }
        }

        // 3 + 4. Where it goes, and what will be made.
        Card {
            title: "Install to";
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.out-dir;
                    horizontal-stretch: 1;
                    color: Theme.text;
                    overflow: elide;
                    vertical-alignment: center;
                }
                TextButton {
                    label: "Change…";
                    width: 90px;
                    enabled: !root.busy && root.can-pick;
                    clicked => { root.change-out(); }
                }
            }
            if root.out-note != "": Text {
                text: root.out-note;
                color: Theme.text-dim;
                wrap: word-wrap;
                font-size: 12px;
            }
            Text {
                text: "What will be made";
                color: Theme.text;
                font-weight: 700;
            }
            HorizontalLayout {
                spacing: 16px;
                PlanColumn { steps: root.plan-left; }
                PlanColumn { steps: root.plan-right; }
            }
        }

        // 5. Make it.
        Card {
            vertical-stretch: 1;
            HorizontalLayout {
                spacing: 12px;
                TextButton {
                    label: root.busy ? "Installing…" : root.outdated ? "Update" : root.done ? "Install again" : "Install";
                    primary: true;
                    width: 130px;
                    enabled: root.can-install && !root.busy;
                    clicked => { root.install(); }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    ProgressIndicator {
                        progress: root.progress;
                        height: 6px;
                    }
                }
                if root.done && root.can-play: TextButton {
                    label: "Play OpenSWOS";
                    primary: true;
                    width: 140px;
                    clicked => { root.play(); }
                }
            }
            Text {
                text: root.status;
                color: root.status-error ? Theme.danger : root.outdated ? Theme.warn : root.done ? Theme.ok : Theme.text-dim;
                font-weight: root.done ? 700 : 400;
                wrap: word-wrap;
            }
            Rectangle {
                background: Theme.field;
                border-width: 1px;
                border-color: Theme.line;
                border-radius: 4px;
                min-height: 60px;
                vertical-stretch: 1;
                log-view := ListView {
                    x: 4px;
                    y: 2px;
                    width: parent.width - 8px;
                    height: parent.height - 4px;
                    for line in root.log: Text {
                        text: line;
                        height: root.log-row;
                        font-family: "monospace";
                        font-size: 11px;
                        color: Theme.text-dim;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 6. The Amiga version's drawer.
        Card {
            title: "Amiga version";
            Text {
                text: "SWOS-Amiga.zip has the program but not the game's data: after installing above, pick the unpacked SWOS drawer and add the data to it.";
                color: Theme.text-dim;
                wrap: word-wrap;
                font-size: 12px;
            }
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.drawer != "" ? root.drawer : "no drawer chosen";
                    horizontal-stretch: 1;
                    color: root.drawer != "" ? Theme.text : Theme.text-dim;
                    overflow: elide;
                    vertical-alignment: center;
                }
                TextButton {
                    label: "Browse…";
                    width: 90px;
                    enabled: !root.busy && root.can-pick;
                    clicked => { root.browse-drawer(); }
                }
                TextButton {
                    label: "Add the game data";
                    enabled: !root.busy && root.drawer != "";
                    clicked => { root.fill-drawer(); }
                }
            }
            if root.drawer-status != "": Text {
                text: root.drawer-status;
                color: root.drawer-error ? Theme.danger : Theme.ok;
                wrap: word-wrap;
            }
        }
    }
}
