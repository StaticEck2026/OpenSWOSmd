{
    "version": "2.0.0",
    "tasks": [
        {
            // Native Windows build (Cygwin) -> bin/SWOS.exe. Default build (Ctrl+Shift+B).
            "label": "Build",
            "type": "process",
            "command": "C:/cygwin64/bin/bash.exe",
            "args": [
                "-lc",
                "cd \"$(cygpath -u \"${workspaceFolder}\")\" && make all"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build (Debug)",
            "type": "process",
            "command": "C:/cygwin64/bin/bash.exe",
            "args": [
                "-lc",
                "cd \"$(cygpath -u \"${workspaceFolder}\")\" && make debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "Clean",
            "type": "process",
            "command": "C:/cygwin64/bin/bash.exe",
            "args": [
                "-lc",
                "cd \"$(cygpath -u \"${workspaceFolder}\")\" && make clean"
            ],
            "problemMatcher": []
        },
        {
            // Linux x86_64 ELF -> bin/SWOS.x86_64. The Linux ELF targets build (and,
            // for x86_64, run) in WSL — Cygwin's gcc makes Windows binaries, not Linux
            // ELF. Per-arch object dirs (build/linux/<arch>) mean NO `make clean` is
            // needed when switching arches. Adjust the project path below if yours differs.
            "label": "Build (x86_64)",
            "detail": "Linux x86_64 ELF (bin/SWOS.x86_64) — built + run in WSL.",
            "type": "process",
            "command": "wsl.exe",
            "args": [
                "bash", "-lc",
                "cd /mnt/c/cygwin64/home/headk/SWOS_C_SDL && make X86_64=1 -j$(nproc)"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            // Linux aarch64 ELF -> bin/SWOS.aarch64. Cross-compiled in WSL
            // (aarch64-linux-gnu-gcc + libsdl2-dev:arm64). Runs on real ARM64 hardware,
            // not on the x86 host.
            "label": "Build (aarch64)",
            "detail": "Linux aarch64 ELF (bin/SWOS.aarch64) — cross-compiled in WSL.",
            "type": "process",
            "command": "wsl.exe",
            "args": [
                "bash", "-lc",
                "cd /mnt/c/cygwin64/home/headk/SWOS_C_SDL && make ARM64=1 -j$(nproc)"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            // Linux armhf ELF -> bin/SWOS.armhf. Cross-compiled in WSL
            // (arm-linux-gnueabihf-gcc + libsdl2-dev:armhf). Runs on a Pi etc.
            "label": "Build (armhf)",
            "detail": "Linux armhf ELF (bin/SWOS.armhf) — cross-compiled in WSL.",
            "type": "process",
            "command": "wsl.exe",
            "args": [
                "bash", "-lc",
                "cd /mnt/c/cygwin64/home/headk/SWOS_C_SDL && make ARM=1 -j$(nproc)"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            // All three Linux ELF arches in one go. Per-arch objdirs => no clean between them.
            "label": "Build (Linux all)",
            "detail": "x86_64 + aarch64 + armhf (separate build/linux/<arch> objdirs).",
            "type": "process",
            "command": "wsl.exe",
            "args": [
                "bash", "-lc",
                "cd /mnt/c/cygwin64/home/headk/SWOS_C_SDL && make X86_64=1 -j$(nproc) && make ARM64=1 -j$(nproc) && make ARM=1 -j$(nproc)"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            // macOS universal binary -> bin/SWOS.macos (x86_64 + arm64 via lipo).
            // MAC ONLY — needs a Darwin host + SDL2.framework; will fail on Windows.
            "label": "Build (macOS universal)",
            "detail": "Mac only — bin/SWOS.macos fat binary. Needs SDL2.framework.",
            "type": "shell",
            "command": "make",
            "args": ["macos-universal"],
            "group": "build",
            "problemMatcher": []
        },
        {
            // WASM is built with emcc (a Linux toolchain), so it runs in WSL, not
            // Cygwin. Adjust the emsdk / project paths below if yours differ.
            "label": "Build (wasm)",
            "type": "process",
            "command": "wsl.exe",
            "args": [
                "bash", "-lc",
                "source /mnt/c/Projects/Linux/emsdk/emsdk_env.sh && cd /mnt/c/cygwin64/home/headk/SWOS_C_SDL && make WASM=1 -j$(nproc)"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            // Serves bin/SWOS.html with emrun (no browser — the launch config opens
            // Edge at localhost:8080). isBackground + the endsPattern below let the
            // debugger wait until emrun is actually listening before launching.
            "label": "Serve (wasm)",
            "type": "process",
            "command": "wsl.exe",
            "args": [
                "bash", "-lc",
                "source /mnt/c/Projects/Linux/emsdk/emsdk_env.sh && cd /mnt/c/cygwin64/home/headk/SWOS_C_SDL/bin && exec emrun --no_browser --port 8080 SWOS.html"
            ],
            "isBackground": true,
            "dependsOn": "Build (wasm)",
            "problemMatcher": {
                "owner": "emrun",
                // A compiler-style error regexp emrun never emits, so normal
                // output ("Web server root…", "Now listening…") is NOT flagged
                // as a problem. The background begins/ends patterns below are
                // what tell VSCode the server is up.
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
                    "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Web server root directory",
                    "endsPattern": "Now listening at"
                }
            }
        },

        {
            // ---- Amiga (m68k) target ----
            // Builds bin/SWOS2 (hunk) + bin/SWOS2.elf via Makefile.amiga using the
            // m68k-amiga-elf toolchain that ships with the bartmanabyss.amiga-debug
            // extension. The `amiga.bin-path` command resolves that toolchain dir.
            // This is the preLaunchTask for the four FS-UAE / WinUAE configs.
            "label": "Build (Amiga)",
            "detail": "m68k Amiga binary (bin/SWOS2) via Makefile.amiga.",
            "type": "shell",
            "windows": {
                "command": "${command:amiga.bin-path}\\gnumake.exe",
                "options": {
                    "cwd": "${workspaceRoot}",
                    "env": {
                        "PATH": "${env:PATH};${command:amiga.bin-path}\\opt\\bin;${command:amiga.bin-path}"
                    }
                }
            },
            "command": "make",
            "options": {
                "cwd": "${workspaceRoot}",
                "env": {
                    "PATH": "${env:PATH}:${command:amiga.bin-path}/opt/bin:${command:amiga.bin-path}"
                }
            },
            "args": [
                "-f", "Makefile.amiga",
                "-j4",
                "program=${config:amiga.program}"
            ],
            "problemMatcher": [
                {
                    "base": "$gcc",
                    "fileLocation": "absolute"
                }
            ],
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "group": "build"
        },
        {
            "label": "Clean (Amiga)",
            "detail": "Remove obj/ + out/ + bin/SWOS2* for the m68k target.",
            "type": "shell",
            "windows": {
                "command": "${command:amiga.bin-path}\\gnumake.exe"
            },
            "command": "make",
            "options": {
                "cwd": "${workspaceRoot}"
            },
            "args": [
                "-f", "Makefile.amiga",
                "clean"
            ],
            "problemMatcher": []
        }
    ]
}
