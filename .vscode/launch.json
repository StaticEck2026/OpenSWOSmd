{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    //
    // Which targets can actually be LAUNCHED from this (Windows) host:
    //   - SWOS.exe       (Cygwin/Windows)  -> "Launch Debug (gbd)"
    //   - SWOS.x86_64    (Linux, WSL)      -> "Launch Debug (x86_64 / WSL)"  (window via WSLg)
    //   - SWOS.html      (WASM, browser)   -> "Launch Debug (wasm)"
    //   - SWOS.macos     (macOS)           -> "Launch Debug (macOS)"  (Mac host only)
    // The aarch64 / armhf ELFs are CROSS-compiled (see the Build tasks) and can't
    // execute on an x86 host, so they have build tasks but no launch config.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Debug (gbd)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/SWOS.exe",
            "cwd": "${workspaceFolder}/bin",
            "preLaunchTask": "Build (Debug)",
            "MIMode": "gdb",
            "miDebuggerPath": "C:/cygwin64/bin/gdb.exe",
            "stopAtEntry": false,
            "externalConsole": true,
            "windows": {
                "program": "${workspaceFolder}/bin/SWOS.exe",
                "args": [],
                "cwd": "${workspaceFolder}/bin"
            },
            "linux": {
                "program": "${workspaceFolder}/bin/SWOS.x86_64",
                "args": [],
                "cwd": "${workspaceFolder}/bin"
            },
            "sourceFileMap": {
                "/home/headk": "C:/cygwin64/home/headk"
            },
            "setupCommands": [
                {
                    "description": "Cygwin under the VS Code gdb launcher delivers a startup SIGHUP (pipes, not a Cygwin pty), which kills the game. Don't pass it to the inferior.",
                    "text": "handle SIGHUP nostop noprint nopass",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            // Debug the Linux x86_64 ELF (bin/SWOS.x86_64) with gdb running INSIDE WSL
            // (pipeTransport spawns `wsl.exe -e /usr/bin/gdb`). The SDL window appears
            // through WSLg. Needs gdb in WSL (`sudo apt install gdb`). Adjust the WSL
            // project path if yours differs. aarch64/armhf are cross-compiled and can't
            // run on the x86 host, so they're build-only.
            "name": "Launch Debug (x86_64 / WSL)",
            "type": "cppdbg",
            "request": "launch",
            "program": "/mnt/c/cygwin64/home/headk/SWOS_C_SDL/bin/SWOS.x86_64",
            "args": [],
            "cwd": "/mnt/c/cygwin64/home/headk/SWOS_C_SDL/bin",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "preLaunchTask": "Build (x86_64)",
            "pipeTransport": {
                "pipeProgram": "C:\\Windows\\System32\\wsl.exe",
                "pipeArgs": ["-e"],
                "debuggerPath": "/usr/bin/gdb",
                "pipeCwd": ""
            },
            "sourceFileMap": {
                "/mnt/c/cygwin64/home/headk/SWOS_C_SDL": "${workspaceFolder}"
            },
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            // Builds the WASM target + serves it with emrun (both in WSL — see the
            // "Build (wasm)" / "Serve (wasm)" tasks), then opens it in Edge. WSL2
            // forwards localhost so the Windows browser reaches the WSL emrun server.
            //
            // The dedicated userDataDir makes the JS debugger spawn a FRESH browser
            // instance it can attach to (fixes "Unable to attach to browser" when
            // Edge is already running). Swap "msedge" -> "chrome" for Chrome.
            // For wasm SOURCE-level (DWARF) stepping install the
            // "C/C++ DevTools Support (DWARF)" extension; plain launch works without it.
            //
            // FALLBACK: if the browser still won't attach, the server is already
            // up — just open http://localhost:8080/SWOS.html in any browser; the
            // game runs there. The CDP attach only adds JS/wasm breakpoints.
            "name": "Launch Debug (wasm)",
            "type": "msedge",
            "request": "launch",
            "url": "http://localhost:8080/SWOS.html",
            "webRoot": "${workspaceFolder}/bin",
            "userDataDir": "${workspaceFolder}/.vscode/.wasm-browser-profile",
            "preLaunchTask": "Serve (wasm)"
        },
        {
            // macOS only — debug bin/SWOS.macos with lldb. Won't run on Windows/WSL
            // (no Mach-O execution there); included for when the repo is opened on a
            // Mac. Build it first with the "Build (macOS universal)" task.
            "name": "Launch Debug (macOS)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/SWOS.macos",
            "args": [],
            "cwd": "${workspaceFolder}/bin",
            "stopAtEntry": false,
            "MIMode": "lldb",
            "preLaunchTask": "Build (macOS universal)"
        },

        {
            "type": "amiga",
            "request": "launch",
            "preLaunchTask": "Build (Amiga)",
            "name": "FS-UAE Debug",
            "config": "A1200",
            "emulatorType": "fs-uae",
            "noExtension": true,
            "chipmem": "2m",
            "fastmem": "8M",
            "program": "${workspaceFolder}/uae/dh0/data/SWOS2",
            "kickstart": "${config:amiga.rom-paths.A1200}",
            "internalConsoleOptions": "openOnSessionStart"
        },
        {
            "type": "amiga",
            "request": "launch",
            "preLaunchTask": "Build (Amiga)",
            "name": "WinUAE Debug",
            "config": "A1200",
            "emulatorType": "winuae",
            "noExtension": true,
            "chipmem": "2m",
            "fastmem": "8M",
            "program": "${workspaceFolder}/uae/dh0/data/SWOS2",
            "emuargs": [
                "-s", "joyport1=kbd2",
                "-s", "norawinput_all",
                "-s", "norawinput_keyboard",
            ],
            "kickstart": "${config:amiga.rom-paths.A1200}",
            "internalConsoleOptions": "openOnSessionStart"
        },
        {
            "type": "amiga",
            "request": "launch",
            "preLaunchTask": "Build (Amiga)",
            "name": "FS-UAE Launch",
            "config": "A1200",
            "emulatorType": "fs-uae",
            "noExtension": true,
            "noDebug": true,
            "chipmem": "2m",
            "fastmem": "8M",
            "program": "${workspaceFolder}/uae/dh0/data/SWOS2",
            "kickstart": "${config:amiga.rom-paths.A1200}",
            "internalConsoleOptions": "openOnSessionStart"
        },
        {
            "type": "amiga",
            "request": "launch",
            "preLaunchTask": "Build (Amiga)",
            "name": "WinUAE Launch",
            "config": "A1200",
            "emulatorType": "winuae",
            "noExtension": true,
            "noDebug": true,
            "chipmem": "2m",
            "fastmem": "8M",
            "program": "${workspaceFolder}/uae/dh0/data/SWOS2",
            "kickstart": "${config:amiga.rom-paths.A1200}",
            "internalConsoleOptions": "openOnSessionStart"
        }
    ]
}
