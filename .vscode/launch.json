{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Debug (gbd)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/SWOS.exe",
            "cwd": "${workspaceFolder}/bin",
            "preLaunchTask": "Build (Debug)",
            "MIMode": "gdb",
            "miDebuggerPath": "C:/cygwin64/bin/gdb.exe",
            "stopAtEntry": false,
            "externalConsole": true,
            "windows": {
                "program": "${workspaceFolder}/bin/SWOS.exe",
                "args": [],
                "cwd": "${workspaceFolder}/bin"
            },
            "linux": {
                "program": "${workspaceFolder}/bin/SWOS.x86_64",
                "args": [],
                "cwd": "${workspaceFolder}/bin"
            },
            "sourceFileMap": {
                "/home/headk": "C:/cygwin64/home/headk"
            },
            "setupCommands": [
                {
                    "description": "Cygwin under the VS Code gdb launcher delivers a startup SIGHUP (pipes, not a Cygwin pty), which kills the game. Don't pass it to the inferior.",
                    "text": "handle SIGHUP nostop noprint nopass",
                    "ignoreFailures": true
                },
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}