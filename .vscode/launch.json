            "request": "launch",
            "preLaunchTask": "compile",
            "name": "FS-UAE Debug",
            "config": "A1200",
            "emulatorType": "fs-uae",
            "noExtension": true,
            "chipmem": "2m",
            "fastmem": "8M",
            "program": "${workspaceFolder}/uae/dh0/data/SWOS2",
            "kickstart": "${config:amiga.rom-paths.A1200}",
            "internalConsoleOptions": "openOnSessionStart"
        },
        {
            "type": "amiga",
            "request": "launch",
            "preLaunchTask": "compile",
