+    }
+    _ballSprite.y.s.i = (int16_t)(gkSprite->y.s.i + yOff);
+    _ballSprite.z.s.i = (int16_t)0;
+    _ballSprite.deltaZ.raw = (int32_t)0;
+    _ballSprite.speed = (int16_t)0;
