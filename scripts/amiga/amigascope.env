# AmigaScope config for the SWOS Amiga bring-up.
# Sourced by the AmigaScope harness (scripts/amiga/amigascope/amiga_gdb.sh) via
# $AMIGASCOPE_ENV, which the scripts/amiga/amiga_gdb.sh shim sets automatically.
FSUAE_BIN="/mnt/c/Projects/Linux/fs-uae/fs-uae"
DH0="/mnt/c/Users/headk/.vscode/extensions/bartmanabyss.amiga-debug-1.8.2/bin/dh0"
DH1="/mnt/c/Projects/AI/SWOS/OpenSWOS/bin"
KICKSTART="/mnt/c/Projects/Amiga/Kickstarts/KICK31_A1200.rom"
TRIGGER=":SWOS2"
ENTRY_PC="0x219b10"      # SWOS2 _start/main; PC here == a healthy stop

# The ELF the gdb daemon loads symbols from, and that the CPU flame graph uses to
# resolve them (it has .debug_frame for unwinding). Exported because gdb_proxy.py
# reads it as the default for --elf: the tool itself must not hard-code a path
# into one particular checkout.
export AMIGASCOPE_ELF="/mnt/c/Projects/AI/SWOS/OpenSWOS/bin/SWOS2.elf"

# The SDL-mode inferior (gdb_proxy.py --mode sdl).
export AMIGASCOPE_BIN="/mnt/c/Projects/AI/SWOS/OpenSWOS/bin/SWOS.x86_64"

# Silence FS-UAE's audio under WSL. WSLg's audio path can't keep an Amiga-rate
# stream fed; when it starves it drags the emulator's frame pacing down with it
# ("fsemu_frame_end called ~2000 ms too late" in the FS-UAE log) and the whole
# session stutters, which also makes any profiling measurement meaningless.
# 'dummy' removes the audio device entirely — note that FS-UAE's own volume=0
# would NOT fix this, since it keeps the starving device open. Exported so the
# FS-UAE child process inherits it.
# Set SWOS_AMIGA_AUDIO=1 in the environment if you need to hear the real thing
# (expect stutter under WSL; on a native Linux host just leave it unset).
if [ -z "${SWOS_AMIGA_AUDIO:-}" ]; then
    export SDL_AUDIODRIVER=dummy
fi
