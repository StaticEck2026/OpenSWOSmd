# AmigaScope config for the SWOS Amiga bring-up.
# Sourced by the AmigaScope harness (scripts/amiga/amigascope/amiga_gdb.sh) via
# $AMIGASCOPE_ENV, which the scripts/amiga/amiga_gdb.sh shim sets automatically.
FSUAE_BIN="/mnt/c/Projects/Linux/fs-uae/fs-uae"
DH0="/mnt/c/Users/headk/.vscode/extensions/bartmanabyss.amiga-debug-1.8.2/bin/dh0"
DH1="/mnt/c/Projects/AI/SWOS/OpenSWOS/bin"
KICKSTART="/mnt/c/Projects/Amiga/Kickstarts/KICK31_A1200.rom"
TRIGGER=":SWOS2"
ENTRY_PC="0x219b10"      # SWOS2 _start/main; PC here == a healthy stop

# CPU flame graph resolves symbols from this ELF (has .debug_frame for unwinding).
export AMIGASCOPE_ELF="/mnt/c/Projects/AI/SWOS/OpenSWOS/bin/SWOS2.elf"
