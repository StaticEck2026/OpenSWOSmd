diff --git a/core/m68k/m68kcpu.c b/core/m68k/m68kcpu.c
index 07d2514..29fc5ba 100644
--- a/core/m68k/m68kcpu.c
+++ b/core/m68k/m68kcpu.c
@@ -254,6 +254,10 @@ void m68k_set_irq_delay(unsigned int int_level)
   m68ki_check_interrupts(); /* Level triggered (IRQ) */
 }
 
+/* OpenSWOS harness (scripts/md/gpgx_romwrite.patch): a cycle-weighted PC profile. */
+unsigned int mdrun_prof_on;
+unsigned int mdrun_prof[0x40000];   /* by PC >> 2, PCs below 1 MB */
+
 void m68k_run(unsigned int cycles) 
 {
   /* Make sure CPU is not already ahead */
@@ -296,6 +300,8 @@ void m68k_run(unsigned int cycles)
       cpu_hook(HOOK_M68K_E, 0, REG_PC, 0);
 #endif
 
+    unsigned int mdrun_pc = REG_PC, mdrun_c0 = m68k.cycles;
+
     /* Decode next instruction */
     REG_IR = m68ki_read_imm_16();
 
@@ -309,6 +315,8 @@ void m68k_run(unsigned int cycles)
     /* Execute instruction */
     m68ki_instruction_jump_table[REG_IR]();
     USE_CYCLES(CYC_INSTRUCTION[REG_IR]);
+    if (mdrun_prof_on && mdrun_pc < 0x100000)
+      mdrun_prof[mdrun_pc >> 2] += m68k.cycles - mdrun_c0;
 
     /* Trace m68k_exception, if necessary */
     m68ki_exception_if_trace(); /* auto-disable (see m68kcpu.h) */
diff --git a/core/mem68k.c b/core/mem68k.c
index 37be6dc..418e37f 100644
--- a/core/mem68k.c
+++ b/core/mem68k.c
@@ -62,8 +62,25 @@ unsigned int m68k_read_bus_16(unsigned int address)
 }
 
 
+/* OpenSWOS harness (scripts/md/gpgx_romwrite.patch): count writes into cartridge ROM. */
+unsigned int mdrun_rom_writes;
+unsigned int mdrun_rom_write_log[64][2];
+static void mdrun_note_rom_write(unsigned int address)
+{
+  if (address < 0x400000)
+  {
+    if (mdrun_rom_writes < 64)
+    {
+      mdrun_rom_write_log[mdrun_rom_writes][0] = address;
+      mdrun_rom_write_log[mdrun_rom_writes][1] = m68k_get_reg(M68K_REG_PC);
+    }
+    mdrun_rom_writes++;
+  }
+}
+
 void m68k_unused_8_w(unsigned int address, unsigned int data)
 {
+  mdrun_note_rom_write(address);
 #ifdef LOGERROR
   error("Unused write8 %08X = %02X (%08X)\n", address, data, m68k_get_reg(M68K_REG_PC));
 #endif
@@ -71,6 +88,7 @@ void m68k_unused_8_w(unsigned int address, unsigned int data)
 
 void m68k_unused_16_w(unsigned int address, unsigned int data)
 {
+  mdrun_note_rom_write(address);
 #ifdef LOGERROR
   error("Unused write16 %08X = %04X (%08X)\n", address, data, m68k_get_reg(M68K_REG_PC));
 #endif
diff --git a/libretro/libretro.c b/libretro/libretro.c
index 798c6cc..ba7aff4 100644
--- a/libretro/libretro.c
+++ b/libretro/libretro.c
@@ -3751,6 +3751,26 @@ void *retro_get_memory_data(unsigned id)
          return sram.on ? sram.sram : NULL;
       case RETRO_MEMORY_SYSTEM_RAM:
          return work_ram;
+      case 0x7F00: /* OpenSWOS harness: ROM write counter + log (core/mem68k.c) */
+      {
+         extern unsigned int mdrun_rom_writes;
+         return &mdrun_rom_writes;
+      }
+      case 0x7F01:
+      {
+         extern unsigned int mdrun_rom_write_log[64][2];
+         return mdrun_rom_write_log;
+      }
+      case 0x7F02: /* the PC profile (core/m68k/m68kcpu.c) and its switch */
+      {
+         extern unsigned int mdrun_prof[];
+         return mdrun_prof;
+      }
+      case 0x7F03:
+      {
+         extern unsigned int mdrun_prof_on;
+         return &mdrun_prof_on;
+      }
       default:
          return NULL;
    }
